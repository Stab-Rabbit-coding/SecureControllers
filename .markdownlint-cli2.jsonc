{
  // markdownlint-cli2 config — see https://github.com/DavidAnson/markdownlint
  // Mirrors the sibling-repo config (Open-Secure-ESC, open-servo-core-secure,
  // LibreServo_v4) so linting rules stay consistent across the workspace.
  "config": {
    "default": true,
    // TODO.md, board .md docs, and REFERENCES-style citation lists carry
    // long single-line entries (URLs, titles, WBS descriptions) by design;
    // wrapping them would harm readability and grep-ability.
    "MD013": false,
    // Citation and reference lists intentionally use bare URLs rather than
    // link syntax.
    "MD034": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    // .remember/ is the local, gitignored session-memory tool state
    // (`.remember/.gitignore` is `*`) — never tracked by git, but
    // markdownlint-cli2's glob is filesystem-based, not git-aware, so it
    // must be excluded explicitly or every contributor's local memory
    // files fail CI on their own machine's untracked content.
    "**/.remember/**",
    // LICENSE.md is verbatim CC-BY-4.0 legal text — never hand-edit a
    // license for lint compliance.
    "LICENSE.md",
    // Pre-existing content that predates this repo's CI (added 2026-09-09).
    // Deliberately NOT reformatted here, and NOT yet added as a TODO.md
    // WBS item — TODO.md's own identity (Serenity-avionics-scoped WBS vs.
    // this repo's new workspace-library role) is an open question in
    // docs/plans/2026-09-08-001-feat-workspace-resource-library-plan.md
    // (U6) pending user resolution; editing it here first would pre-empt
    // that decision. Follow-up cleanup for these files is tracked in the
    // PR description instead until TODO.md's structure is settled.
    "TODO.md",
    "CLAUDE.md",
    "firmware/README.md",
    "kicad/README.md",
    "kicad/**/*.md",
    // docs/plans/** is generated by the ce-plan skill using its own
    // markdown-rendering convention (tight lists directly under bold
    // field labels, no blank-line padding) — a tooling/format
    // characteristic of every plan this skill produces, not an authoring
    // lapse in this one document.
    "docs/plans/**/*.md"
  ]
}
