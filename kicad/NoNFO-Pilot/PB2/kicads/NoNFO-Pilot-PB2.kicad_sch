    (property "Reference" "U-1V8RF" (at 330.20 356.87 0) (effects (font (size 1.27 1.27))))
    (property "Value" "TLV75718PDBVR" (at 330.20 372.11 0) (effects (font (size 1.27 1.27))))
    (property "Footprint" "Package_TO_SOT_SMD:SOT-23-5" (at 330.20 364.49 0) (effects (font (size 1.27 1.27)) (hide yes)))
    (property "Datasheet" "tlv757p.pdf Table 4-1 Pin Functions (DBV: 1 IN, 2 GND, 3 EN, 4 NC, 5 OUT), Table 8-1 nomenclature (18 = 1.8 V fixed, P = active discharge), 1 A, CIN/COUT >= 1 uF. Owner 2026-10-05: replaces the TPS62933 1.8 V buck (and its 3015 inductor, bootstrap, soft-start, EN and FB parts) to free board area. Load: WIFI-BT-ZB AVDD18 + SD_VIO, TYPE2EL.pdf typical 148-180 mA Tx / 101-130 mA Rx at 1.8 V (rated max 1009 mA); dissipation (3.3-1.8) x 0.18 A = 0.27 W, ~62 C rise at the DBV 231 C/W JEDEC figure — copper pour on IN/OUT/GND required. Fed from +3V3_RF per the owner's choice." (at 330.20 364.49 0) (effects (font (size 1.27 1.27)) (hide yes)))
    (property "MPN" "TLV75718PDBVR" (at 330.20 364.49 0) (effects (font (size 1.27 1.27)) (hide yes)))
